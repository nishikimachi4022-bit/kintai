<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#1769d1"><title>勤怠管理</title>
<style>*{box-sizing:border-box}body{margin:0;background:#eef3f8;color:#17212b;font-family:-apple-system,BlinkMacSystemFont,"Noto Sans JP","Yu Gothic",sans-serif}.app{max-width:560px;min-height:100vh;margin:auto;background:#fff}header{position:sticky;top:0;z-index:10;background:#fff;border-bottom:1px solid #dce4ed;padding:13px 15px}.head{display:flex;justify-content:space-between;align-items:center}h1{font-size:20px;margin:0}.clock{text-align:right;font-size:12px;color:#667085}main{padding:12px 14px 70px}.card{border:1px solid #dce4ed;border-radius:16px;padding:14px;margin-bottom:12px}.label{font-size:12px;font-weight:700;color:#667085;margin-bottom:7px}select,input{width:100%;height:46px;border:1px solid #cbd5e1;border-radius:11px;padding:0 11px;font-size:16px;background:#fff}.buttons{display:grid;grid-template-columns:1fr 1fr;gap:10px}.punch{height:88px;border:0;border-radius:15px;color:#fff;font-size:18px;font-weight:800}.punch small{display:block;font-size:11px;margin-top:5px}.in{background:#159447}.bs{background:#e88908}.be{background:#7656d6}.out{background:#d9362b}.punch:disabled{background:#c8d0da}.status{font-size:13px;line-height:1.7;color:#475467;margin-top:9px}.ok{color:#16803c}.err{color:#c62828}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.stat{background:#eef5ff;border-radius:12px;text-align:center;padding:10px 3px}.stat b{display:block;font-size:17px}.stat span{font-size:10px;color:#667085}.tabs{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:10px}.tab{height:42px;border:1px solid #dce4ed;border-radius:10px;background:#fff;font-weight:700}.tab.active{background:#1769d1;color:#fff;border-color:#1769d1}.panel{display:none}.panel.active{display:block}.btn{height:44px;width:100%;border:0;border-radius:11px;background:#1769d1;color:#fff;font-weight:800}.sub{background:#eef2f6;color:#344054}.row2{display:grid;grid-template-columns:1fr 1fr;gap:9px}table{width:100%;border-collapse:collapse;font-size:11px}th,td{padding:7px 4px;border-bottom:1px solid #e5e7eb;text-align:center;white-space:nowrap}th{background:#f7f9fb}.red{color:#c62828;font-weight:800}.note{font-size:11px;color:#667085;line-height:1.6}.url{display:flex;gap:6px}.url input{flex:1}.url button{width:80px}.danger{color:#c62828}</style></head><body><div class="app"><header><div class="head"><h1>勤怠管理</h1><div class="clock"><div id="clock">--:--:--</div><div id="date"></div></div></div></header><main>
<section class="card"><div class="label">従業員</div><select id="employee"></select><div id="status" class="status"></div></section>
<section class="card"><div style="text-align:center;font-size:13px;color:#667085;margin-bottom:8px">本日の打刻</div><div class="buttons"><button id="in" class="punch in" onclick="punch('in')">出勤<small>出勤時にタップ</small></button><button id="bs" class="punch bs" onclick="punch('breakStart')">休憩開始<small>休憩に入る時</small></button><button id="be" class="punch be" onclick="punch('breakEnd')">休憩終了<small>戻った時</small></button><button id="out" class="punch out" onclick="punch('out')">退勤<small>退勤時にタップ</small></button></div></section>
<section class="card"><div class="label">本日の状態</div><div class="stats"><div class="stat"><b id="type">-</b><span>勤務区分</span></div><div class="stat"><b id="elapsed">-</b><span>経過時間</span></div><div class="stat"><b id="ot">-</b><span>残業</span></div></div><p class="note">半日勤務は4時間、1日勤務は8時間勤務＋1時間休憩＝9時間を基準に残業を計算します。</p></section>
<div class="tabs"><button class="tab active" onclick="show('records',this)">勤怠一覧</button><button class="tab" onclick="show('settings',this)">設定</button></div>
<section id="records" class="panel active card"><div class="row2"><div><div class="label">対象月</div><input id="month" type="month"></div><div style="display:flex;align-items:end"><button class="btn" onclick="render()">表示</button></div></div><div id="table" style="overflow:auto;margin-top:10px"></div><button class="btn sub" style="margin-top:10px" onclick="downloadCSV()">CSV出力</button></section>
<section id="settings" class="panel card"><div class="label">Google Apps Script URL</div><div class="url"><input id="gas" placeholder="https://script.google.com/macros/s/.../exec"><button class="btn" onclick="saveGas()">保存</button></div><div id="msg" class="status"></div><p class="note">このURLはGoogle Apps ScriptのWebアプリURLです。保存後、テスト打刻を1件行ってください。</p></section>
</main></div><script>
const EMP=[['錦町','神野',1001],['錦町','横川',1002],['錦町','渡邉',1003],['錦町','戸澤',1004],['錦町','松本',1005],['錦町','根本',1006],['入船','小野寺',1001],['入船','増見',1002],['入船','阿部',1003],['入船','渡邊',1004],['メルヘン','齊藤',1001],['メルヘン','大橋',1002],['メルヘン','福井',1003],['メルヘン','小谷',1004]];const KEY='attendance_v4',GKEY='attendance_gas_v4';let db=JSON.parse(localStorage.getItem(KEY)||'{}');const pad=n=>String(n).padStart(2,'0');const today=()=>{const d=new Date();return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())};const now=()=>{const d=new Date();return pad(d.getHours())+':'+pad(d.getMinutes())};const mins=t=>{if(!t)return null;const [h,m]=t.split(':').map(Number);return h*60+m};const diff=(a,b)=>{let x=mins(a),y=mins(b);if(x==null||y==null)return null;if(y<x)y+=1440;return y-x};const fmt=n=>n==null?'-':Math.floor(n/60)+':'+pad(n%60);function selected(){return EMP.find(x=>x[1]===document.getElementById('employee').value)}function key(d,e){return d+'_'+e[0]+'_'+e[1]}function rec(d=today()){let e=selected();return db[key(d,e)]||null}function save(){localStorage.setItem(KEY,JSON.stringify(db))}
function init(){let s=document.getElementById('employee');['錦町','入船','メルヘン'].forEach(st=>{let g=document.createElement('optgroup');g.label=st;EMP.filter(e=>e[0]===st).forEach(e=>{let o=document.createElement('option');o.value=e[1];o.textContent=e[1];g.appendChild(o)});s.appendChild(g)});s.value=localStorage.getItem('lastEmp')||'神野';s.onchange=()=>{localStorage.setItem('lastEmp',s.value);refresh();render()};document.getElementById('gas').value=localStorage.getItem(GKEY)||'';document.getElementById('month').value=today().slice(0,7);refresh();render();tick()}
function tick(){const d=new Date();document.getElementById('clock').textContent=pad(d.getHours())+':'+pad(d.getMinutes())+':'+pad(d.getSeconds());document.getElementById('date').textContent=d.getFullYear()+'/'+(d.getMonth()+1)+'/'+d.getDate();calc();setTimeout(tick,1000)}
function refresh(){const r=rec();document.getElementById('in').disabled=!!r?.in;document.getElementById('bs').disabled=!r?.in||!!r?.breakStart||!!r?.out;document.getElementById('be').disabled=!r?.breakStart||!!r?.breakEnd||!!r?.out;document.getElementById('out').disabled=!r?.in||!!r?.out;document.getElementById('status').textContent=r?'出勤 '+(r.in||'—')+'　休憩 '+(r.breakStart||'—')+'～'+(r.breakEnd||'—')+'　退勤 '+(r.out||'—'):'まだ打刻されていません';calc()}
function calc(){const r=rec();const e=r?.in&&r?.out?diff(r.in,r.out):null;let type=r?.workType||'auto';if(type==='auto')type=e!=null&&e<=240?'half':e!=null?'full':'';const ot=e==null?null:Math.max(0,e-(type==='half'?240:540));document.getElementById('type').textContent=type==='half'?'半日':type==='full'?'1日':'-';document.getElementById('elapsed').textContent=fmt(e);document.getElementById('ot').textContent=fmt(ot)}
function makePayload(r){const elapsed=r.in&&r.out?diff(r.in,r.out):0;let type=r.workType||'auto';if(type==='auto')type=elapsed<=240?'half':'full';return {...r,workedMin:elapsed,workType:type,overtimeMin:Math.max(0,elapsed-(type==='half'?240:540))}}
async function punch(action){const e=selected(),d=today(),k=key(d,e),r=db[k]||{date:d,store:e[0],name:e[1],code:e[2],workType:'auto'};const t=now();if(action==='in')r.in=t;if(action==='breakStart')r.breakStart=t;if(action==='breakEnd'){r.breakEnd=t;r.breakMin=diff(r.breakStart,r.breakEnd)||0}if(action==='out')r.out=t;db[k]=r;save();refresh();render();await send(makePayload(r))}
async function send(r){const url=localStorage.getItem(GKEY);if(!url){document.getElementById('status').className='status';document.getElementById('status').textContent+='　※GAS未設定';return}try{await fetch(url,{method:'POST',mode:'no-cors',body:JSON.stringify(r)});document.getElementById('status').className='status ok';document.getElementById('status').textContent+='　✓送信済み'}catch(e){document.getElementById('status').className='status err';document.getElementById('status').textContent+='　⚠送信失敗'}}
function render(){const ym=document.getElementById('month').value,e=selected();const a=Object.values(db).filter(r=>r.store===e[0]&&r.name===e[1]&&r.date.startsWith(ym)).sort((a,b)=>a.date.localeCompare(b.date));if(!a.length){document.getElementById('table').innerHTML='<div class="status">この月の記録はありません</div>';return}document.getElementById('table').innerHTML='<table><tr><th>日</th><th>出勤</th><th>退勤</th><th>休憩</th><th>経過</th><th>残業</th><th>区分</th></tr>'+a.map(r=>{let p=makePayload(r);return '<tr><td>'+r.date.slice(5)+'</td><td>'+(r.in||'')+'</td><td>'+(r.out||'')+'</td><td>'+(r.breakMin||0)+'</td><td>'+fmt(p.workedMin)+'</td><td class="red">'+fmt(p.overtimeMin)+'</td><td>'+(p.workType==='half'?'半日':'1日')+'</td></tr>'}).join('')+'</table>'}
function downloadCSV(){const ym=document.getElementById('month').value,e=selected();const a=Object.values(db).filter(r=>r.store===e[0]&&r.name===e[1]&&r.date.startsWith(ym)).sort((a,b)=>a.date.localeCompare(b.date));let rows=[['営業日','店舗','従業員コード','氏名','出勤打刻','休憩開始','休憩終了','退勤打刻','休憩分','経過分','勤務区分','残業分'],...a.map(r=>{let p=makePayload(r);return [r.date,r.store,r.code,r.name,r.in||'',r.breakStart||'',r.breakEnd||'',r.out||'',r.breakMin||0,p.workedMin,p.workType,p.overtimeMin]})];let csv='\uFEFF'+rows.map(x=>x.map(v=>'"'+String(v).replaceAll('"','""')+'"').join(',')).join('\n');let aEl=document.createElement('a');aEl.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));aEl.download='勤怠_'+e[0]+'_'+e[1]+'_'+ym+'.csv';aEl.click()}
function show(id,b){document.querySelectorAll('.panel').forEach(x=>x.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));b.classList.add('active')}function saveGas(){localStorage.setItem(GKEY,document.getElementById('gas').value.trim());document.getElementById('msg').className='status ok';document.getElementById('msg').textContent='保存しました'}init();
</script></body></html>
